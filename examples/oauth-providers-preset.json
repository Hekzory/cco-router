{
  "name": "oauth-providers",
  "version": "1.0.0",
  "description": "Claude and Codex OAuth providers for routing between Anthropic and OpenAI models",
  "author": "CCR Team",
  "keywords": [
    "claude",
    "anthropic",
    "codex",
    "chatgpt",
    "oauth"
  ],
  "ccrVersion": "2.1.10",
  "Providers": [
    {
      "name": "claude",
      "api_base_url": "https://api.anthropic.com",
      "api_key": "no-key",
      "models": [
        "claude-opus-5",
        "claude-sonnet-5",
        "claude-fable-5",
        "claude-haiku-4-5-20251001",
        "claude-opus-4-8",
        "claude-sonnet-4-6"
      ],
      "transformer": {
        "use": [
          "claude-auth",
          "Anthropic"
        ]
      }
    },
    {
      "name": "codex",
      "api_base_url": "https://chatgpt.com/backend-api/codex",
      "api_key": "oauth_dummy_key",
      "models": [
        "gpt-5.4",
        "gpt-5.5",
        "gpt-5.6-sol",
        "gpt-5.6-terra",
        "gpt-5.6-luna",
        "gpt-6-astra",
        "gpt-6.1-sol",
        "gpt-6-sol",
        "gpt-6-luna",
        "gpt-5.4-mini",
        "codex-auto-review"
      ],
      "transformer": {
        "use": [
          "openai-responses",
          "codex"
        ]
      }
    }
  ],
  "Router": {
    "default": "claude,claude-sonnet-5",
    "think": "codex,gpt-6.1-sol",
    "background": "claude,claude-haiku-4-5",
    "webSearch": "claude,claude-opus-5",
    "longContext": "codex,gpt-6.1-sol",
    "longContextThreshold": 60000
  },
  "HOST": "0.0.0.0"
}
